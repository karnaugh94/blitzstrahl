{
  "name": "blitzstrahl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "default": "./dist/theme.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    }
  },
  "files": [
    "dist",
    "client"
  ],
  "dependencies": {
    "@blitzstrahl/core": "workspace:*",
    "@blitzstrahl/renderers": "workspace:*",
    "@blitzstrahl/runtime": "workspace:*",
    "@blitzstrahl/themes": "workspace:*",
    "@types/hast": "^3.0.5",
    "hast-util-to-html": "^9.0.5",
    "import-meta-resolve": "^4.2.0",
    "katex": "^0.18.9",
    "playwright-core": "1.63.0",
    "shiki": "^4.4.3",
    "vite": "^8.3.0"
  },
  "bin": {
    "blitzstrahl": "./dist/bin.js"
  }
}
